# PostgreSQL (pgvector)
DATABASE_URL=postgresql+asyncpg://agent_team:agent_team_dev@localhost:5432/agent_team

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible object storage)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=agent-artifacts

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model tiers (defaults shown — override to pin specific versions)
# MODEL_SONNET=claude-sonnet-4-20250514
# MODEL_HAIKU=claude-haiku-4-5-20251001
# MODEL_OPUS=claude-opus-4-20250514

# Optional: Serper API for web search tool
# SERPER_API_KEY=your-serper-key-here

# CORS (comma-separated origins are not supported — edit settings.py for multiple)
# CORS_ORIGINS=["http://localhost:3000"]
