ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL (pgvector)
DATABASE_URL=postgresql+asyncpg://agent_team:agent_team_dev@localhost:5432/agent_team

# Redis (Celery broker + PubSub)
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible object storage for stateless workspaces)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=agent-artifacts
S3_REGION=us-east-1

# Legacy — will be removed after pgvector migration
CHROMA_PERSIST_DIR=./data/chromadb
SKILLS_DIR=./data/skills

# GITHUB_TOKEN is optional — only needed for GitHub API search (issues, PRs, public repo search).
# Git clone/push operations use SSH (your ~/.ssh key configured on the host machine).
# GITHUB_TOKEN=ghp_your_token_here
