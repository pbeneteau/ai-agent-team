# Copy this file to .env and fill in the required values.
# [REQUIRED] fields must be set before the app will work.
# All others have safe defaults for local development.

# PostgreSQL (asyncpg)
# For local dev (outside Docker): localhost:5432
# Docker Compose overrides this with the 'postgres' service name automatically.
DATABASE_URL=postgresql+asyncpg://agent_team:agent_team_dev@localhost:5432/agent_team

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible object storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=agent-artifacts
S3_REGION=us-east-1

# Anthropic API  [REQUIRED]
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model tiers (defaults use Claude 4.x — override to pin specific versions)
# MODEL_SONNET=claude-sonnet-4-20250514
# MODEL_HAIKU=claude-haiku-4-5-20251001
# MODEL_OPUS=claude-opus-4-20250514

# Encryption key for PATs and auth configs (Fernet)
# [REQUIRED in production] Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=dev-secret-change-in-production

# Webhook base URL (used when auto-configuring webhooks on repos)
WEBHOOK_BASE_URL=http://localhost:8000

# Optional integrations
# SERPER_API_KEY=      # Web search for agents (https://serper.dev — free tier: 2500/mo)
# VOYAGE_API_KEY=      # Voyage AI embeddings (fallback: pgvector without Voyage)

# CORS origins (edit settings.py for multiple origins)
# CORS_ORIGINS=["http://localhost:3005"]
